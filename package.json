{
  "name": "analyst",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint",
    "smoke:ach": "npx tsx src/lib/__smoke__/ach_determinism.ts",
    "smoke:patch": "npx tsx src/lib/__smoke__/patch_apply.ts",
    "smoke:integrity": "npx tsx src/lib/__smoke__/integrity_determinism.ts"
  },
  "dependencies": {
    "cytoscape": "^3.30.4",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "next": "^14.2.0",
    "playwright": "^1.58.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.8",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "typescript": "^5.6.3"
  }
}
